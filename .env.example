# Bu dosyayı .env olarak kopyalayıp gerçek değerleri doldurun:
#   cp .env.example .env
# .env commit'lenmez (.gitignore'da); gerçek sırlar sadece kendi
# makinenizde / sunucunuzda kalır. docker-compose.yaml bu dosyayı
# otomatik okuyup ${DEĞİŞKEN} yer tutucularının yerine koyar.

# --- iyzico ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PUBLIC_BASE_URL=http://localhost:8080

# --- /admin yönetim paneli ---
# Panelde giriş yapacağınız kullanıcı adı ve şifre; siz belirleyin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Oturum çerezini imzalamak için rastgele, uzun bir dize (örn. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=
